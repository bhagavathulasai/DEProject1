# Environment variables for DentalVision AI
# Copy this file to .env and fill in your local values.

# Core app settings
APP_NAME=DentalVision API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
PORT=8000
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# Required for the Groq-based image validation step.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override model location if you have a trained model file.
DENTALVISION_MODEL_PATH=
DENTALVISION_MODEL_DIR=./models
DENTALVISION_DATASET_DIR=./Data set
DENTALVISION_STORAGE_DIR=./storage/secure
DENTALVISION_UPLOAD_DIR=./storage/uploads

# PostgreSQL connection string for SQLAlchemy.
DATABASE_URL=postgresql://dentalvision:dentalvision@localhost:5432/dentalvision

# Optional Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
